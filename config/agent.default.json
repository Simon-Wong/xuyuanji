{
  "model": {
    "default": "qwen-plus",
    "planner": "qwen-plus",
    "selector": "qwen-turbo",
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "api_key_env": "DASHSCOPE_API_KEY",
    "max_context_tokens": 32768
  },
  "cache": {
    "enabled": false,
    "dir": ".cache",
    "version": "v1"
  },
  "sandbox": {
    "image": "python:3.12-slim",
    "max_containers": 5,
    "timeout": 600
  },
  "budget": {
    "max_depth": 3,
    "max_tokens": 100000,
    "max_tool_calls": 50
  },
  "logging": {
    "level": "INFO",
    "trace_enabled": true,
    "log_dir": "logs",
    "enable_total_file": true,
    "enable_component_files": true,
    "enable_warning_file": true,
    "enable_console": true,
    "max_bytes": 10485760,
    "backup_count": 5
  },
  "db": {
    "path": "data/agent.db",
    "journal_mode": "WAL"
  },
  "context": {
    "compress_threshold": {
      "type": "message_count",
      "value": 20
    },
    "recent_messages": {
      "type": "count",
      "value": 6
    }
  },
  "token_counter": {
    "impl": "rough",
    "model": "qwen-plus"
  }
}
